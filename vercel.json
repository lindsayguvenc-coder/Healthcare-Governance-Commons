{
  "rewrites": [
    {
      "source": "/community-weaving",
      "destination": "/community-weaving/index.html"
    },
    {
      "source": "/transition",
      "destination": "/transition/index.html"
    },
    {
      "source": "/roi-assessment",
      "destination": "/roi-assessment/index.html"
    },
    {
      "source": "/nodes/:id",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/queue.js": {
      "maxDuration": 60
    },
    "api/synthesize.js": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "data-archive": false
    }
  },
  "redirects": [
    {
      "source": "/agent-qc",
      "destination": "/qc-setup",
      "permanent": true
    },
    {
      "source": "/agent-qc/",
      "destination": "/qc-setup",
      "permanent": true
    },
    {
      "source": "/agent-qc/index.html",
      "destination": "/qc-setup",
      "permanent": true
    },
    {
      "source": "/consultation",
      "destination": "/tools",
      "permanent": true
    },
    {
      "source": "/consultation/:path*",
      "destination": "/tools",
      "permanent": true
    }
  ]
}
